<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Notifications</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-zinc-50 via-zinc-100/50 to-indigo-50/20 text-zinc-900 antialiased min-h-screen selection:bg-indigo-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'notifications' }) %>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-8 flex items-center justify-between bg-white/80 backdrop-blur-xl p-6 rounded-3xl border border-zinc-200/80 shadow-sm">
      <div class="space-y-1">
        <h1 class="text-2xl font-extrabold tracking-tight text-zinc-900 flex items-center gap-2">
          <span>Notifications</span>
          <% if (notifications && notifications.length > 0) { %>
            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100"><%= notifications.length %></span>
          <% } %>
        </h1>
        <p class="text-xs font-medium text-zinc-500">Updates on your posts and community interactions</p>
      </div>

      <% if (notifications && notifications.length > 0) { %>
        <form action="/notifications/clear" method="post">
          <button type="submit" class="text-xs font-semibold px-3.5 py-2 bg-zinc-100 hover:bg-zinc-200/70 text-zinc-700 rounded-xl transition-all">
            Clear All
          </button>
        </form>
      <% } %>
    </div>

    <div class="space-y-3">
      <% if (!notifications || notifications.length === 0) { %>
        <div class="bg-white/80 rounded-3xl border border-zinc-200/80 shadow-sm p-12 text-center space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </div>
          <p class="text-zinc-600 font-semibold text-sm">No notifications yet</p>
          <p class="text-xs text-zinc-400">When someone comments or interacts with your posts, you'll see it here.</p>
        </div>
      <% } else { %>
        <% notifications.forEach(function(notif) { %>
          <div class="bg-white/90 backdrop-blur-xl rounded-2xl border border-zinc-200/80 shadow-2xs p-4 flex items-start space-x-3 transition-all hover:border-zinc-300">
            <div class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 border border-indigo-100">
              <%= notif.sender && notif.sender.name ? notif.sender.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="flex-1 min-w-0 space-y-0.5">
              <p class="text-xs font-semibold text-zinc-900 leading-snug">
                <span class="font-bold text-indigo-600">@<%= notif.sender ? notif.sender.username : 'Someone' %></span>
                <%= notif.type === 'comment' ? 'commented on your post:' : 'interacted with your post:' %>
              </p>
              <p class="text-xs text-zinc-600 font-medium truncate"><%= notif.message %></p>
              <p class="text-[10px] font-medium text-zinc-400 pt-1">
                <%= new Date(notif.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </p>
            </div>
            <a href="/feed" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-xl transition-all shrink-0">
              View
            </a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
</body>
</html>
