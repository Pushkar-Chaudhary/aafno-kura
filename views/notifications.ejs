<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Notifications</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,400;1,6..72,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      background-color: #f3f6f0;
      background-image: 
        radial-gradient(rgba(4, 120, 87, 0.08) 0.5px, transparent 0.5px),
        linear-gradient(to right, rgba(6, 78, 59, 0.02) 1px, transparent 1px);
      background-size: 14px 14px, 40px 40px;
    }
    .font-newspaper { font-family: 'Newsreader', serif; }
  </style>
</head>
<body class="text-emerald-950 antialiased min-h-screen selection:bg-emerald-800 selection:text-amber-100">
  <%- include('partials/navbar', { user, activePage: 'notifications' }) %>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    
    <!-- Headline Banner -->
    <div class="mb-8 border-t-2 border-b-2 border-emerald-950/30 py-4 text-center space-y-1 bg-[#fafcf7]/80 backdrop-blur-sm">
      <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-800">Telegraph & Official Dispatches</p>
      <h1 class="font-newspaper font-black text-3xl tracking-tight text-emerald-950">Recent Notifications</h1>
      <p class="text-xs font-serif italic text-emerald-900/70">"Incoming telegrams from the reader community."</p>
    </div>

    <div class="mb-6 flex items-center justify-between">
      <h2 class="font-newspaper font-bold text-xl text-emerald-950">
        Dispatches Log (<%= notifications ? notifications.length : 0 %>)
      </h2>

      <% if (notifications && notifications.length > 0) { %>
        <form action="/notifications/clear" method="post">
          <button type="submit" class="text-xs font-bold px-3.5 py-1.5 bg-emerald-100 hover:bg-emerald-200/80 text-emerald-950 rounded-lg border border-emerald-900/20 transition-all">
            Clear All Dispatches
          </button>
        </form>
      <% } %>
    </div>

    <div class="space-y-3">
      <% if (!notifications || notifications.length === 0) { %>
        <div class="bg-[#fafcf7] rounded-xl border border-emerald-900/20 shadow-sm p-12 text-center space-y-3">
          <p class="font-newspaper font-bold text-lg text-emerald-950">No Telegram Dispatches Received</p>
          <p class="text-xs font-serif italic text-emerald-800/70">When community members reply to your articles, your notices will appear here.</p>
        </div>
      <% } else { %>
        <% notifications.forEach(function(notif) { %>
          <div class="bg-[#fafcf7] rounded-xl border border-emerald-900/20 shadow-[2px_3px_0px_rgba(6,78,59,0.06)] p-4 flex items-start space-x-3 transition-all hover:border-emerald-800/40">
            <div class="w-9 h-9 rounded bg-emerald-950 text-amber-100 flex items-center justify-center font-newspaper font-bold text-sm shrink-0 border border-emerald-800">
              <%= notif.sender && notif.sender.name ? notif.sender.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="flex-1 min-w-0 space-y-1">
              <p class="text-xs font-bold text-emerald-950">
                <span class="font-mono text-emerald-800">@<%= notif.sender ? notif.sender.username : 'Someone' %></span>
                <%= notif.type === 'comment' ? 'sent a response letter:' : 'endorsed your article:' %>
              </p>
              <p class="text-xs font-serif italic text-emerald-900/80 truncate"><%= notif.message %></p>
              <p class="text-[10px] font-mono text-emerald-800/60">
                <%= new Date(notif.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </p>
            </div>
            <a href="/feed" class="text-xs font-bold text-amber-100 bg-emerald-900 hover:bg-emerald-950 px-3 py-1.5 rounded-lg transition-all shrink-0">
              Read &rarr;
            </a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
</body>
</html>
