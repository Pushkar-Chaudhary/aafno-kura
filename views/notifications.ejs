<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Notifications</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: 'Manrope', sans-serif;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.10), transparent 22%),
        linear-gradient(135deg, #f9f6f2 0%, #f3f7ff 45%, #f8fafc 100%);
      color: #0f172a;
    }
    .font-brand { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen selection:bg-violet-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'notifications' }) %>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-8 rounded-2xl border border-slate-200 bg-white px-6 py-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.26em] text-violet-600">Alerts</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">Notifications</h1>
      <p class="mt-1 text-sm text-slate-500">Recent reactions and updates from your community.</p>
    </div>

    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-bold text-slate-900">Inbox (<%= notifications ? notifications.length : 0 %>)</h2>

      <% if (notifications && notifications.length > 0) { %>
        <form action="/notifications/clear" method="post">
          <button type="submit" class="rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-100">
            Clear all
          </button>
        </form>
      <% } %>
    </div>

    <div class="space-y-3">
      <% if (!notifications || notifications.length === 0) { %>
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-sm">
          <p class="text-lg font-bold text-slate-900">No notifications yet</p>
          <p class="mt-2 text-sm text-slate-500">You will see likes and comments here when they happen.</p>
        </div>
      <% } else { %>
        <% notifications.forEach(function(notif) { %>
          <div class="flex items-start space-x-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-violet-600 text-sm font-bold text-white">
              <%= notif.sender && notif.sender.name ? notif.sender.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="min-w-0 flex-1 space-y-1">
              <p class="text-xs font-bold text-slate-700">
                <span class="font-semibold text-violet-700">@<%= notif.sender ? notif.sender.username : 'Someone' %></span>
                <%= notif.type === 'comment' ? 'commented on your post:' : 'liked your post:' %>
              </p>
              <p class="truncate text-xs text-slate-500"><%= notif.message %></p>
              <p class="text-[10px] uppercase tracking-wide text-slate-400">
                <%= new Date(notif.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </p>
            </div>
            <a href="/feed" class="shrink-0 rounded-lg bg-violet-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-violet-700">
              View
            </a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </main>
</body>
</html>

