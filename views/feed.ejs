<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Community Feed</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: 'Manrope', sans-serif;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.10), transparent 22%),
        linear-gradient(135deg, #f9f6f2 0%, #f3f7ff 45%, #f8fafc 100%);
      color: #0f172a;
    }
    .font-brand { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen selection:bg-violet-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'feed' }) %>

  <% const currentUserIsAdmin = user && (user.role === 'admin' || user.email === 'pushkarchaudhary256@gmail.com'); %>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-8 rounded-2xl border border-slate-200 bg-white px-6 py-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.26em] text-violet-600">Community feed</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">Latest posts</h1>
      <p class="mt-1 text-sm text-slate-500">Updates from everyone in the community.</p>
    </div>

    <div class="space-y-6">
      <% if (!posts || posts.length === 0) { %>
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center shadow-sm">
          <p class="text-xl font-bold text-slate-900">No posts yet</p>
          <p class="mt-2 text-sm text-slate-500">Be the first person to publish something.</p>
          <a href="/dashboard" class="mt-4 inline-block rounded-xl bg-violet-600 px-4 py-2 text-xs font-bold text-white hover:bg-violet-700">
            + Create post
          </a>
        </div>
      <% } %>

      <% posts.forEach(function(post) { %>
        <% const isLiked = post.likes ? post.likes.some(id => id.toString() === user._id.toString()) : false; %>
        <% const authorName = post.user ? post.user.name : 'Unknown Author'; %>
        <% const authorUsername = post.user ? post.user.username : 'user'; %>
        <% const authorIsAdmin = post.user && (post.user.role === 'admin' || post.user.email === 'pushkarchaudhary256@gmail.com'); %>
        <% const isPostOwner = post.user && (post.user._id ? post.user._id.toString() : post.user.toString()) === user._id.toString(); %>

        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <div class="flex items-center space-x-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-violet-600 text-white">
                <% if (authorIsAdmin) { %>
                  <span class="text-sm font-extrabold">A</span>
                <% } else { %>
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21a8 8 0 0 0-16 0"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                <% } %>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <p class="text-base font-bold text-slate-900"><%= authorName %></p>
                  <% if (authorIsAdmin) { %>
                    <span class="rounded-full bg-amber-100 px-1.5 py-0.5 text-[8px] font-black uppercase tracking-wider text-slate-900">Admin</span>
                  <% } %>
                </div>
                <p class="mt-0.5 text-xs font-semibold text-violet-600">@<%= authorUsername %></p>
              </div>
            </div>

            <div class="flex items-center space-x-3">
              <span class="text-xs text-slate-500">
                <%= new Date(post.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </span>
              <% if (isPostOwner || currentUserIsAdmin) { %>
                <form action="/post/<%= post._id %>/delete" method="post" class="inline" onsubmit="return confirm('Delete this post?');">
                  <button type="submit" class="rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-[11px] font-bold text-rose-700 hover:bg-rose-100">
                    <%= currentUserIsAdmin && !isPostOwner ? 'Delete (Admin)' : 'Delete' %>
                  </button>
                </form>
              <% } %>
            </div>
          </div>

          <div class="mt-4 whitespace-pre-wrap text-sm leading-7 text-slate-700">
            <%= post.content %>
          </div>

          <% if (post.image) { %>
            <div class="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
              <img src="<%= post.image %>" alt="Post image" class="max-h-[500px] w-full object-cover" />
            </div>
          <% } %>

          <div class="mt-5 flex items-center space-x-4 border-t border-slate-200 pt-3 text-xs font-bold">
            <form action="/post/<%= post._id %>/like" method="post">
              <button type="submit" class="rounded-lg border px-3 py-1.5 transition active:scale-95 <%= isLiked ? 'border-rose-200 bg-rose-50 text-rose-700' : 'border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100' %>">
                ♥ <%= post.likes ? post.likes.length : 0 %>
              </button>
            </form>

            <span class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-slate-700">
              <%= post.comments ? post.comments.length : 0 %> comments
            </span>
          </div>

          <div class="mt-5 space-y-3 border-t border-slate-200 pt-4">
            <% if (post.comments && post.comments.length > 0) { %>
              <div class="max-h-64 space-y-2 overflow-y-auto rounded-xl bg-slate-50 p-3">
                <% post.comments.forEach(function(comment) { %>
                  <% const commentUser = comment.user ? comment.user.username : 'anonymous'; %>
                  <% const commentUserId = comment.user ? (comment.user._id ? comment.user._id.toString() : comment.user.toString()) : ''; %>
                  <% const isCommentOwner = commentUserId === user._id.toString(); %>

                  <div class="rounded-xl border border-slate-200 bg-white p-3 text-xs">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-1">
                      <span class="font-semibold text-slate-700">@<%= commentUser %></span>

                      <% if (isCommentOwner || isPostOwner || currentUserIsAdmin) { %>
                        <div class="flex items-center gap-2">
                          <% if (isCommentOwner) { %>
                            <button type="button" onclick="document.getElementById('edit-comment-<%= comment._id %>').classList.toggle('hidden')" class="text-[10px] font-bold text-violet-700 hover:underline">
                              Edit
                            </button>
                          <% } %>
                          <form action="/post/<%= post._id %>/comment/<%= comment._id %>/delete" method="post" class="inline" onsubmit="return confirm('Delete this comment?');">
                            <button type="submit" class="text-[10px] font-bold text-rose-700 hover:underline">
                              <%= currentUserIsAdmin && !isCommentOwner && !isPostOwner ? 'Remove (Admin)' : 'Remove' %>
                            </button>
                          </form>
                        </div>
                      <% } %>
                    </div>

                    <p class="mt-2 text-slate-700"><%= comment.text %></p>

                    <% if (isCommentOwner) { %>
                      <form id="edit-comment-<%= comment._id %>" action="/post/<%= post._id %>/comment/<%= comment._id %>/edit" method="post" class="hidden pt-2">
                        <input type="text" name="comment" value="<%= comment.text %>" class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs outline-none focus:border-violet-400 focus:ring-2 focus:ring-violet-100" required />
                        <div class="mt-2 flex justify-end gap-2">
                          <button type="button" onclick="document.getElementById('edit-comment-<%= comment._id %>').classList.add('hidden')" class="rounded-lg bg-slate-100 px-2.5 py-1.5 text-[10px] font-bold text-slate-700">Cancel</button>
                          <button type="submit" class="rounded-lg bg-violet-600 px-2.5 py-1.5 text-[10px] font-bold text-white">Save</button>
                        </div>
                      </form>
                    <% } %>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <form action="/post/<%= post._id %>/comment" method="post" class="flex gap-2">
              <input
                type="text"
                name="comment"
                placeholder="Write a comment..."
                class="flex-1 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-xs outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100 placeholder:text-slate-400"
                required
              />
              <button type="submit" class="rounded-xl bg-violet-600 px-4 py-2.5 text-xs font-bold text-white hover:bg-violet-700">
                Comment
              </button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  </main>
</body>
</html>

