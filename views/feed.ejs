<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Community Feed</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen">
  <%- include('partials/navbar', { user }) %>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-gray-900">Community Feed</h1>
        <p class="text-sm text-gray-500">Discover recent posts and join the conversation</p>
      </div>
      <a href="/dashboard" class="text-xs font-semibold px-3 py-2 bg-indigo-50 text-indigo-600 hover:bg-indigo-100 rounded-lg transition">
        + New Post
      </a>
    </div>

    <div class="space-y-6">
      <% if (!posts || posts.length === 0) { %>
        <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-8 text-center">
          <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          <p class="text-gray-500 text-sm">No community posts yet.</p>
        </div>
      <% } %>

      <% posts.forEach(function(post) { %>
        <% const isLiked = post.likes.some(id => id.toString() === user._id.toString()); %>
        <% const authorName = post.user ? post.user.name : 'Unknown User'; %>
        <% const authorUsername = post.user ? post.user.username : 'user'; %>

        <article class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-6 space-y-4">
          <!-- Author info -->
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-sm">
              <%= authorName.charAt(0).toUpperCase() %>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900 leading-none"><%= authorName %></p>
              <p class="text-xs text-indigo-600 font-medium mt-0.5">@<%= authorUsername %></p>
            </div>
            <span class="text-xs text-gray-400 ml-auto">
              <%= new Date(post.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </span>
          </div>

          <!-- Content -->
          <p class="text-gray-800 text-sm leading-relaxed whitespace-pre-wrap"><%= post.content %></p>

          <!-- Post Actions -->
          <div class="pt-3 border-t border-gray-100 flex items-center space-x-4 text-xs">
            <form action="/post/<%= post._id %>/like" method="post">
              <button type="submit" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border transition font-medium <%= isLiked ? 'bg-red-50 text-red-600 border-red-200' : 'bg-gray-50 text-gray-600 border-gray-200 hover:bg-gray-100' %>">
                <svg class="w-4 h-4 <%= isLiked ? 'fill-red-600 text-red-600' : 'text-gray-500' %>" fill="<%= isLiked ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                <span><%= post.likes ? post.likes.length : 0 %> <%= post.likes && post.likes.length === 1 ? 'Like' : 'Likes' %></span>
              </button>
            </form>

            <span class="text-gray-400 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              <span><%= post.comments ? post.comments.length : 0 %> Comments</span>
            </span>
          </div>

          <!-- Comments section -->
          <div class="pt-4 border-t border-gray-100 space-y-3">
            <% if (post.comments && post.comments.length > 0) { %>
              <div class="space-y-2 bg-gray-50 rounded-xl p-3 max-h-60 overflow-y-auto">
                <% post.comments.forEach(function(comment) { %>
                  <% const commentUser = comment.user ? comment.user.username : 'anonymous'; %>
                  <div class="text-xs bg-white rounded-lg p-2.5 border border-gray-200/60 shadow-2xs">
                    <span class="font-bold text-gray-900">@<%= commentUser %></span>
                    <span class="text-gray-700 ml-1"><%= comment.text %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <!-- Add comment form -->
            <form action="/post/<%= post._id %>/comment" method="post" class="flex gap-2">
              <input
                type="text"
                name="comment"
                placeholder="Write a comment..."
                class="flex-1 bg-gray-50 border border-gray-200 rounded-xl px-3.5 py-2 text-xs outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition"
                required
              />
              <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-semibold rounded-xl transition">
                Reply
              </button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  </main>
</body>
</html>
