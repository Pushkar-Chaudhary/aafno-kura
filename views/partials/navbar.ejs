<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-xl">
  <div class="bg-slate-950 px-4 py-2 text-[10px] uppercase tracking-[0.28em] text-slate-300">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3">
      <span>Aafnokura</span>
      <span><%= new Date().toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center space-x-8">
        <a href="/dashboard" class="group flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-violet-600 via-violet-500 to-amber-400 text-xl font-extrabold text-white shadow-[0_10px_30px_rgba(109,40,217,0.25)] transition group-hover:scale-[1.02]">
            📭
          </div>
          <div class="flex flex-col">
            <span class="text-2xl font-extrabold leading-none text-slate-900">Aafnokura</span>
            <span class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-500">Social App</span>
          </div>
        </a>

        <div class="hidden items-center space-x-1 text-xs font-semibold uppercase tracking-wide sm:flex">
          <a href="/dashboard" class="rounded-xl px-3.5 py-2 transition-all <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'bg-violet-600 text-white shadow-md shadow-violet-200' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
            Dashboard
          </a>
          <a href="/feed" class="rounded-xl px-3.5 py-2 transition-all <%= typeof activePage !== 'undefined' && activePage === 'feed' ? 'bg-violet-600 text-white shadow-md shadow-violet-200' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
            Feed
          </a>
          <a href="/notifications" class="flex items-center gap-1.5 rounded-xl px-3.5 py-2 transition-all <%= typeof activePage !== 'undefined' && activePage === 'notifications' ? 'bg-violet-600 text-white shadow-md shadow-violet-200' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
            <span>Alerts</span>
            <% const unreadCount = user && user.notifications ? user.notifications.filter(n => !n.read).length : 0; %>
            <% if (unreadCount > 0) { %>
              <span class="flex h-4 w-4 items-center justify-center rounded-full bg-amber-400 text-[10px] font-black text-slate-900"><%= unreadCount %></span>
            <% } %>
          </a>
          <a href="/profile" class="rounded-xl px-3.5 py-2 transition-all <%= typeof activePage !== 'undefined' && activePage === 'profile' ? 'bg-violet-600 text-white shadow-md shadow-violet-200' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
            Profile
          </a>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <a href="/profile" class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-200">
          <div class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-full bg-gradient-to-br from-violet-600 to-violet-500 text-[10px] font-bold text-white">
            <% const isAdminUser = user && (user.role === 'admin' || user.email === 'pushkarchaudhary256@gmail.com'); %>
            <% if (user && user.avatar) { %>
              <img src="<%= user.avatar %>" alt="Profile" class="h-full w-full object-cover" />
            <% } else if (isAdminUser) { %>
              <span>A</span>
            <% } else { %>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21a8 8 0 0 0-16 0"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            <% } %>
          </div>
          <span class="hidden md:inline">@<%= user.username %></span>
        </a>

        <a href="/logout" class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-100 hover:text-slate-900">
          Logout
        </a>
      </div>
    </div>
  </div>
</header>