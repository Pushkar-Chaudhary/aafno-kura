<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Edit Profile</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: 'Manrope', sans-serif;
      background: linear-gradient(135deg, #f5f7ff 0%, #eef2ff 38%, #f8fafc 100%);
      color: #1f2937;
    }
    .font-display { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="antialiased min-h-screen">
  <%- include('partials/navbar', { user, activePage: 'profile' }) %>

  <main class="max-w-xl mx-auto px-4 sm:px-6 py-10">
    <div class="bg-white/90 rounded-2xl border border-slate-200 shadow-lg p-6 sm:p-8">
      <div class="flex items-center justify-between pb-5 border-b border-slate-200 mb-6">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-violet-500 font-bold">Profile</p>
          <h1 class="font-display text-3xl text-slate-900">Edit your details</h1>
        </div>
        <a href="/profile" class="text-sm font-semibold text-violet-600 hover:text-violet-700">Back</a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700 font-medium">
          <%= error %>
        </div>
      <% } %>

      <form action="/profile/edit" method="post" enctype="multipart/form-data" class="space-y-4">
        <div class="flex items-center justify-center pb-2">
          <div class="flex h-24 w-24 items-center justify-center overflow-hidden rounded-full border border-slate-200 bg-slate-100 shadow-sm">
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="Profile preview" class="h-full w-full object-cover" />
            <% } else if (user.role === 'admin' || user.email === 'pushkarchaudhary256@gmail.com') { %>
              <span class="text-4xl font-black text-violet-600">A</span>
            <% } else { %>
              <svg class="h-10 w-10 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21a8 8 0 0 0-16 0"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            <% } %>
          </div>
        </div>

        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-3">
          <label class="flex cursor-pointer items-center justify-between gap-3 text-xs font-semibold text-slate-600">
            <span>Profile picture</span>
            <input type="file" name="avatar" accept="image/*" class="max-w-[180px] text-[11px] text-slate-500 file:mr-3 file:rounded-lg file:border-0 file:bg-violet-100 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-violet-700" />
          </label>
        </div>

        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
          <input type="checkbox" name="useDefaultAvatar" value="1" class="rounded border-slate-300 text-violet-600 focus:ring-violet-500" />
          Use default profile picture
        </label>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Full name</label>
          <input type="text" name="name" value="<%= values.name %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-violet-200 focus:border-violet-400" required />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Username</label>
          <input type="text" name="username" value="<%= values.username %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-violet-200 focus:border-violet-400" required />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Email</label>
          <input type="email" name="email" value="<%= values.email %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-violet-200 focus:border-violet-400" required />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Age</label>
          <input type="number" name="age" min="13" max="120" value="<%= values.age %>" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-violet-200 focus:border-violet-400" required />
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" class="flex-1 py-3 bg-violet-600 hover:bg-violet-700 text-white font-semibold rounded-xl transition">
            Save Changes
          </button>
          <a href="/profile" class="flex-1 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl text-center transition">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
