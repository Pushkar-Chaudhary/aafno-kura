<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Profile</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-zinc-50 via-zinc-100/50 to-indigo-50/20 text-zinc-900 antialiased min-h-screen selection:bg-indigo-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'profile' }) %>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    
    <!-- Profile Card Header -->
    <div class="bg-white/90 backdrop-blur-xl rounded-3xl border border-zinc-200/80 shadow-sm p-6 sm:p-8 mb-8">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
        <div class="w-20 h-20 rounded-3xl bg-gradient-to-tr from-indigo-600 to-violet-600 text-white flex items-center justify-center font-black text-3xl shadow-lg shadow-indigo-500/25 shrink-0">
          <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="space-y-1">
          <h1 class="text-2xl font-extrabold text-zinc-900"><%= user.name %></h1>
          <p class="text-sm font-bold text-indigo-600">@<%= user.username %></p>
          <p class="text-xs font-medium text-zinc-400"><%= user.email %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-zinc-100 max-w-sm">
        <div class="bg-zinc-50/80 rounded-2xl p-4 text-center border border-zinc-200/60">
          <p class="text-[10px] text-zinc-400 font-bold uppercase tracking-wider">Posts Published</p>
          <p class="text-2xl font-black text-zinc-900 mt-0.5"><%= posts.length %></p>
        </div>
        <div class="bg-zinc-50/80 rounded-2xl p-4 text-center border border-zinc-200/60">
          <p class="text-[10px] text-zinc-400 font-bold uppercase tracking-wider">Likes Received</p>
          <p class="text-2xl font-black text-zinc-900 mt-0.5"><%= typeof totalLikes !== 'undefined' ? totalLikes : 0 %></p>
        </div>
      </div>
    </div>

    <!-- Posts Header -->
    <div class="space-y-4">
      <h2 class="text-lg font-bold text-zinc-900 px-1">Your Publications</h2>

      <% if (!posts || posts.length === 0) { %>
        <div class="bg-white/80 rounded-3xl border border-zinc-200/80 shadow-sm p-10 text-center space-y-3">
          <p class="text-zinc-500 text-sm font-semibold">You haven't posted anything yet.</p>
          <a href="/dashboard" class="inline-block text-xs font-bold px-4 py-2.5 bg-indigo-600 text-white rounded-2xl shadow-md shadow-indigo-600/20 hover:bg-indigo-700 transition">
            Create your first post
          </a>
        </div>
      <% } else { %>
        <% posts.forEach(function(post) { %>
          <% const isLiked = post.likes ? post.likes.some(id => id.toString() === user._id.toString()) : false; %>
          <article class="bg-white/90 backdrop-blur-xl rounded-3xl border border-zinc-200/80 shadow-sm p-6 space-y-4">
            <div class="flex items-center justify-between text-xs text-zinc-400 font-medium">
              <span><%= new Date(post.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
            </div>

            <p class="text-zinc-800 text-sm leading-relaxed whitespace-pre-wrap font-medium"><%= post.content %></p>

            <div class="pt-3 border-t border-zinc-100 flex items-center justify-between text-xs">
              <form action="/post/<%= post._id %>/like" method="post" class="inline">
                <button type="submit" class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl border transition-all font-semibold active:scale-90 <%= isLiked ? 'bg-rose-50 text-rose-600 border-rose-200/80' : 'bg-zinc-50/80 text-zinc-600 border-zinc-200/80 hover:bg-zinc-100' %>">
                  <svg class="w-4 h-4 <%= isLiked ? 'fill-rose-600 text-rose-600' : 'text-zinc-400' %>" fill="<%= isLiked ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                  <span><%= post.likes ? post.likes.length : 0 %></span>
                </button>
              </form>

              <div class="flex items-center space-x-2">
                <a href="/post/<%= post._id %>/edit" class="px-3.5 py-1.5 rounded-xl border border-zinc-200/80 bg-zinc-50/80 text-zinc-700 hover:bg-zinc-100 transition-all font-semibold">
                  Edit
                </a>
                <form action="/post/<%= post._id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');" class="inline">
                  <button type="submit" class="px-3.5 py-1.5 rounded-xl border border-rose-200/80 bg-rose-50/80 text-rose-600 hover:bg-rose-100 transition-all font-semibold">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>
  </main>
</body>
</html>