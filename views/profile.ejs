<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50">

  <div class="min-h-screen w-full px-4 py-6">

 
    <div class="flex justify-end max-w-2xl mx-auto">
      <a
        href="/logout"
        class="px-4 py-2 text-sm text-white bg-black rounded-md hover:bg-gray-800 transition"
      >
        Logout
      </a>
    </div>

    <div class="max-w-2xl mx-auto mt-16">

      <h3 class="text-2xl font-semibold text-black">
        Hello <%= user.name %> 👋
      </h3>

      <p class="mt-2 text-gray-500">
        You can create a post
      </p>

      <form action="/post" method="post" class="mt-6">

        <textarea
          name="content"
          placeholder="What's on your mind?"
          rows="5"
          class="w-full px-4 py-3 text-sm border border-gray-300 rounded-md outline-none resize-none focus:border-black transition"
        ></textarea>

        <input
          type="submit"
          value="Create"
          class="mt-3 px-4 py-2 text-sm text-white bg-black rounded-md cursor-pointer hover:bg-gray-800 transition"
        >

      </form>
      <div class="posts mt-20">
        <h3 class="text-md">Your Posts.</h3>
        <div class="post-container space-y-4">
           <% user.posts.forEach(function(post){ %>
            <div class="post border rounded-md p-4 bg-white">
              <h4 class="text-blue-500 mb-2">@<%= user.username %></h4>
              <p class="text-gray-700"><%= post.content %></p>

              <div class="mt-3 flex items-center gap-3 text-sm">
                <form action="/post/<%= post._id %>/like" method="post">
                  <button type="submit" class="text-blue-600">👍 <%= post.likes.length %></button>
                </form>

                <% if (post.user && post.user.toString && post.user.toString() === user._id.toString()) { %>
                  <a href="/post/<%= post._id %>/edit" class="text-gray-700">Edit</a>
                  <form action="/post/<%= post._id %>/delete" method="post">
                    <button type="submit" class="text-red-600">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

  </div>

</body>
</html>