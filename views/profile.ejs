<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <%- include('partials/navbar', { user }) %>

  <main class="max-w-4xl mx-auto px-3 sm:px-4 py-6 sm:py-8">
    <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
      <div class="flex items-center space-x-4">
        <div class="bg-black text-white rounded-full w-14 h-14 flex items-center justify-center font-bold text-xl">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <div>
          <h2 class="text-2xl font-bold"><%= user.name %></h2>
          <p class="text-gray-500">@<%= user.username %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6">
      <h3 class="text-xl font-semibold mb-4">Your posts</h3>

      <div class="space-y-4">
        <% if (!user.posts || user.posts.length === 0) { %>
          <p class="text-gray-500">You haven't posted anything yet.</p>
        <% } else { %>
          <% user.posts.forEach(function(post) { %>
            <article class="border border-gray-200 rounded-2xl p-4">
              <p class="text-gray-800 whitespace-pre-wrap"><%= post.content %></p>

              <div class="mt-4 flex items-center gap-4 text-sm">
                <form action="/post/<%= post._id %>/like" method="post">
                  <button type="submit" class="text-blue-600">👍 <%= post.likes.length %></button>
                </form>
                <a href="/post/<%= post._id %>/edit" class="text-gray-700">Edit</a>
                <form action="/post/<%= post._id %>/delete" method="post">
                  <button type="submit" class="text-red-600">Delete</button>
                </form>
              </div>
            </article>
          <% }) %>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>