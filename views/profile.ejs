<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Profile</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen">
  <%- include('partials/navbar', { user }) %>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    
    <!-- Profile Card Header -->
    <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-6 sm:p-8 mb-8">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
        <div class="w-20 h-20 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-bold text-3xl shadow-md">
          <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="space-y-1">
          <h1 class="text-2xl font-bold text-gray-900"><%= user.name %></h1>
          <p class="text-sm text-indigo-600 font-semibold">@<%= user.username %></p>
          <p class="text-xs text-gray-500"><%= user.email %></p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-gray-100 max-w-sm">
        <div class="bg-gray-50 rounded-xl p-3 text-center border border-gray-100">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Posts</p>
          <p class="text-xl font-extrabold text-gray-900 mt-0.5"><%= posts.length %></p>
        </div>
        <div class="bg-gray-50 rounded-xl p-3 text-center border border-gray-100">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">Likes Received</p>
          <p class="text-xl font-extrabold text-gray-900 mt-0.5"><%= typeof totalLikes !== 'undefined' ? totalLikes : 0 %></p>
        </div>
      </div>
    </div>

    <!-- Posts Header -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-gray-900 px-1">Your Publications</h2>

      <% if (!posts || posts.length === 0) { %>
        <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-8 text-center">
          <p class="text-gray-500 text-sm">You haven't posted anything yet.</p>
          <a href="/dashboard" class="mt-3 inline-block text-xs font-semibold px-4 py-2 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition">
            Create your first post
          </a>
        </div>
      <% } else { %>
        <% posts.forEach(function(post) { %>
          <% const isLiked = post.likes ? post.likes.some(id => id.toString() === user._id.toString()) : false; %>
          <article class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-5 space-y-3">
            <div class="flex items-center justify-between text-xs text-gray-400">
              <span><%= new Date(post.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
            </div>

            <p class="text-gray-800 text-sm leading-relaxed whitespace-pre-wrap"><%= post.content %></p>

            <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
              <form action="/post/<%= post._id %>/like" method="post" class="inline">
                <button type="submit" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border transition font-medium <%= isLiked ? 'bg-red-50 text-red-600 border-red-200' : 'bg-gray-50 text-gray-600 border-gray-200 hover:bg-gray-100' %>">
                  <svg class="w-4 h-4 <%= isLiked ? 'fill-red-600 text-red-600' : 'text-gray-500' %>" fill="<%= isLiked ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                  <span><%= post.likes ? post.likes.length : 0 %></span>
                </button>
              </form>

              <div class="flex items-center space-x-2">
                <a href="/post/<%= post._id %>/edit" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-gray-50 text-gray-700 hover:bg-gray-100 transition font-medium">
                  Edit
                </a>
                <form action="/post/<%= post._id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');" class="inline">
                  <button type="submit" class="px-3 py-1.5 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100 transition font-medium">
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>
  </main>
</body>
</html>