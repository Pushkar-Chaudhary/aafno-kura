<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-zinc-50 via-zinc-100/60 to-indigo-50/30 text-zinc-900 antialiased min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

  <div class="flex-1 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      
      <!-- Brand Header -->
      <div class="text-center mb-8 space-y-2">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-gradient-to-tr from-indigo-600 to-violet-600 text-white font-black text-2xl rounded-2xl shadow-lg shadow-indigo-500/25 hover:scale-105 transition-transform duration-300">
          A
        </div>
        <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900">Aafnokura</h1>
        <p class="text-sm font-medium text-zinc-500">Welcome back! Sign in to continue</p>
      </div>

      <!-- Card -->
      <div class="bg-white/80 backdrop-blur-xl rounded-3xl border border-zinc-200/80 shadow-xl shadow-zinc-200/50 p-6 sm:p-8">
        
        <% if (typeof registered !== 'undefined' && registered) { %>
          <div class="mb-5 rounded-2xl border border-emerald-200/80 bg-emerald-50/80 p-4 text-xs font-semibold text-emerald-800 flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <div>Account created successfully! Please sign in with your credentials.</div>
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="mb-5 rounded-2xl border border-rose-200/80 bg-rose-50/80 p-4 text-xs font-semibold text-rose-700 flex items-start gap-3">
            <svg class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div><%= error %></div>
          </div>
        <% } %>

        <form action="/login" method="post" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-zinc-600 uppercase tracking-wider mb-1.5">Email or Username</label>
            <input 
              type="text" 
              name="identifier" 
              placeholder="pushkar or name@example.com" 
              class="w-full px-4 py-3 bg-zinc-50/80 border border-zinc-200 rounded-2xl outline-none focus:bg-white focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/10 transition-all text-sm font-medium" 
              required 
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-zinc-600 uppercase tracking-wider mb-1.5">Password</label>
            <input 
              type="password" 
              name="password" 
              placeholder="Enter your password" 
              class="w-full px-4 py-3 bg-zinc-50/80 border border-zinc-200 rounded-2xl outline-none focus:bg-white focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/10 transition-all text-sm font-medium" 
              required 
            />
          </div>

          <button 
            type="submit" 
            class="w-full mt-3 py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] text-white font-bold rounded-2xl shadow-md shadow-indigo-600/20 hover:shadow-lg hover:shadow-indigo-600/30 transition-all duration-200 cursor-pointer text-sm"
          >
            Sign In
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-zinc-100 text-center">
          <p class="text-sm font-medium text-zinc-600">
            Don’t have an account?
            <a href="/" class="text-indigo-600 hover:text-indigo-700 font-bold transition">Create one</a>
          </p>
        </div>
      </div>

    </div>
  </div>

  <footer class="py-6 text-center text-xs font-medium text-zinc-400">
    &copy; <%= new Date().getFullYear() %> Aafnokura &bull; Clean, Minimal & Cloud-Connected.
  </footer>

</body>
</html>