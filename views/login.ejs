<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    
    <div class="w-full h-screen bg-white-600"><h3 class="text-black w-full max-w-sm mx-auto space-y-3">User Login</h3>
<form action="/login" method="post" class="w-full max-w-sm mx-auto space-y-3">
<input
 type="email"
 name="email"
 placeholder="Email"
 class="w-full px-3 py-2.5 border border-gray-300 rounded-md outline-none focus:border-black transition"
/>

<input
 type="password"
 name="password"
 placeholder="Password"
 class="w-full px-3 py-2.5 border border-gray-300 rounded-md outline-none focus:border-black transition"
/>

<input
 type="submit"
 value="Login"
 class="w-full px-3 py-2.5 bg-black text-white rounded-md cursor-pointer hover:bg-gray-800 transition"
/>

</form>

    </div>
</body>
</html>