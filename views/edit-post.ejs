<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Edit Article</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: 'Manrope', sans-serif;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.10), transparent 22%),
        linear-gradient(135deg, #f9f6f2 0%, #f3f7ff 45%, #f8fafc 100%);
      color: #0f172a;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen selection:bg-violet-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'dashboard' }) %>

  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <div class="rounded-2xl border border-slate-200 bg-white/90 p-6 shadow-[0_16px_40px_rgba(15,23,42,0.05)] backdrop-blur-sm sm:p-8">
      <h1 class="border-b border-slate-200 pb-3 text-2xl font-extrabold text-slate-900">
        Edit post
      </h1>

      <form action="/post/<%= post._id %>/edit" method="post" enctype="multipart/form-data" class="mt-6 space-y-4">
        <div>
          <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-600">Post caption</label>
          <textarea
            name="content"
            rows="6"
            maxlength="2000"
            class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-800 outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100"
          ><%= post.content %></textarea>
        </div>

        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-3">
          <label class="flex cursor-pointer items-center justify-between gap-3 text-xs font-semibold text-slate-600">
            <span>Replace image</span>
            <input type="file" name="image" accept="image/*" class="max-w-[180px] text-[11px] text-slate-500 file:mr-3 file:rounded-lg file:border-0 file:bg-violet-100 file:px-3 file:py-1.5 file:text-xs file:font-bold file:text-violet-700" />
          </label>
        </div>

        <% if (post.image) { %>
          <div class="space-y-2">
            <img src="<%= post.image %>" alt="Current post image" class="max-h-60 w-full rounded-xl object-cover border border-slate-200" />
            <label class="flex items-center gap-2 text-xs font-medium text-slate-600">
              <input type="checkbox" name="removeImage" value="1" class="rounded border-slate-300 text-violet-600 focus:ring-violet-500" />
              Remove current image
            </label>
          </div>
        <% } %>

        <div class="flex items-center gap-3 pt-2">
          <button type="submit" class="rounded-xl bg-gradient-to-r from-violet-600 to-violet-500 px-5 py-2.5 text-xs font-bold text-white shadow-[0_12px_28px_rgba(109,40,217,0.22)] transition hover:from-violet-500 hover:to-violet-600">
            Save changes →
          </button>
          <a href="/dashboard" class="rounded-xl border border-slate-200 bg-slate-50 px-5 py-2.5 text-xs font-bold text-slate-700 transition hover:bg-slate-100">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>

