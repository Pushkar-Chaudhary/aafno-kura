<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Post</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50">
  <div class="max-w-xl mx-auto mt-20 p-6 bg-white rounded-md shadow-sm">
    <h3 class="text-2xl font-semibold mb-6">Edit Post</h3>

    <form action="/post/<%= post._id %>/edit" method="post">
      <textarea
        name="content"
        rows="5"
        class="w-full px-4 py-3 border border-gray-300 rounded-md outline-none resize-none"
      ><%= post.content %></textarea>

      <div class="mt-4 flex gap-3">
        <button type="submit" class="px-4 py-2 bg-black text-white rounded-md">Save</button>
        <a href="/profile" class="px-4 py-2 border border-gray-300 rounded-md">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>
