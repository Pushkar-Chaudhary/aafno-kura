<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Edit Post</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-zinc-50 via-zinc-100/50 to-indigo-50/20 text-zinc-900 antialiased min-h-screen selection:bg-indigo-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'dashboard' }) %>

  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white/90 backdrop-blur-xl rounded-3xl border border-zinc-200/80 shadow-sm p-6 sm:p-8 space-y-6">
      <h1 class="text-xl font-bold text-zinc-900 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
        Edit Your Post
      </h1>

      <form action="/post/<%= post._id %>/edit" method="post" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-zinc-600 uppercase tracking-wider mb-1.5">Post Content</label>
          <textarea
            name="content"
            rows="5"
            maxlength="2000"
            class="w-full bg-zinc-50/80 border border-zinc-200 rounded-2xl p-4 text-sm font-medium text-zinc-900 outline-none focus:bg-white focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/10 transition-all resize-none"
            required
          ><%= post.content %></textarea>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button 
            type="submit" 
            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold rounded-2xl shadow-md shadow-indigo-600/20 transition-all"
          >
            Save Changes
          </button>
          <a 
            href="/dashboard" 
            class="px-5 py-2.5 bg-zinc-100 hover:bg-zinc-200 text-zinc-700 text-xs font-semibold rounded-2xl transition-all"
          >
            Cancel
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
