<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Edit Post</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen">
  <%- include('partials/navbar', { user }) %>

  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-6 sm:p-8">
      <h1 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Edit Your Post
      </h1>

      <form action="/post/<%= post._id %>/edit" method="post" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Post Content</label>
          <textarea
            name="content"
            rows="5"
            class="w-full bg-gray-50 border border-gray-200 rounded-xl p-4 text-sm text-gray-900 outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition resize-none"
            required
          ><%= post.content %></textarea>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button 
            type="submit" 
            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-sm font-semibold rounded-xl shadow-sm transition"
          >
            Save Changes
          </button>
          <a 
            href="/dashboard" 
            class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-xl transition"
          >
            Cancel
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
