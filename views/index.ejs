<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Create Account</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: 'Manrope', sans-serif;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.12), transparent 28%),
        radial-gradient(circle at bottom right, rgba(251, 191, 36, 0.15), transparent 25%),
        linear-gradient(135deg, #f8f5f1 0%, #f4f7ff 40%, #f8fafc 100%);
      color: #0f172a;
    }
    .font-brand { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="antialiased min-h-screen flex flex-col justify-between selection:bg-violet-500 selection:text-white">

  <div class="flex-1 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-violet-600 text-white font-brand font-extrabold text-2xl rounded-2xl shadow-lg shadow-violet-200 mb-4">
          A
        </div>
        <h1 class="font-brand text-4xl font-extrabold tracking-tight text-slate-900">Aafnokura</h1>
        <p class="mt-2 text-sm text-slate-500">Create your account and start posting</p>
      </div>

      <div class="bg-white/90 rounded-2xl border border-slate-200 shadow-[0_16px_40px_rgba(15,23,42,0.06)] p-6 sm:p-8 backdrop-blur-sm">
        <h2 class="font-brand text-xl font-bold text-slate-900 mb-6">Create account</h2>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm font-medium text-rose-700">
            <%= error %>
          </div>
        <% } %>

        <form action="/register" method="post" class="space-y-4">
          <div>
            <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-600">Full Name</label>
            <input 
              type="text" 
              name="name"
              value="<%= typeof formValues !== 'undefined' ? formValues.name || '' : '' %>"
              placeholder="e.g. Pushkar Chaudhary"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100"
              required 
            />
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="col-span-2">
              <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-600">Username</label>
              <input 
                type="text" 
                name="username"
                value="<%= typeof formValues !== 'undefined' ? formValues.username || '' : '' %>"
                placeholder="pushkar"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100"
                required 
              />
            </div>
            <div>
              <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-600">Age</label>
              <input 
                type="number" 
                name="age" 
                min="13" 
                max="120"
                value="<%= typeof formValues !== 'undefined' ? formValues.age || '' : '' %>" 
                placeholder="18"
                class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100" 
              />
            </div>
          </div>

          <div>
            <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-600">Email Address</label>
            <input 
              type="email" 
              name="email"
              value="<%= typeof formValues !== 'undefined' ? formValues.email || '' : '' %>"
              placeholder="name@example.com"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100"
              required 
            />
          </div>

          <div>
            <label class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-slate-600">Password</label>
            <input 
              type="password" 
              name="password" 
              placeholder="Minimum 8 characters"
              class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100"
              required 
            />
          </div>

          <button 
            type="submit"
            class="w-full mt-3 py-3.5 px-4 bg-gradient-to-r from-violet-600 to-violet-500 hover:from-violet-500 hover:to-violet-600 text-white font-semibold rounded-xl shadow-[0_12px_28px_rgba(109,40,217,0.22)] transition text-sm"
          >
            Create account
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-emerald-900/10 text-center">
          <p class="text-sm text-slate-500">
            Already have an account?
            <a href="/login" class="text-violet-600 font-semibold hover:text-violet-700">Sign in</a>
          </p>
        </div>
      </div>

    </div>
  </div>

  <footer class="py-6 text-center text-xs text-slate-500">
    &copy; <%= new Date().getFullYear() %> Aafnokura &bull; All rights reserved.
  </footer>

</body>
</html>