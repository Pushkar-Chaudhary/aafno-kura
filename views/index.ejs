<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Create Account</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,400;1,6..72,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      background-color: #f3f6f0;
      background-image: 
        radial-gradient(rgba(4, 120, 87, 0.08) 0.5px, transparent 0.5px),
        linear-gradient(to right, rgba(6, 78, 59, 0.02) 1px, transparent 1px);
      background-size: 14px 14px, 40px 40px;
    }
    .font-newspaper { font-family: 'Newsreader', serif; }
  </style>
</head>
<body class="text-emerald-950 antialiased min-h-screen flex flex-col justify-between selection:bg-emerald-800 selection:text-amber-100">

  <div class="flex-1 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <!-- Newspaper Header -->
      <div class="text-center mb-8 space-y-2 border-b-2 border-emerald-950/20 pb-6">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-emerald-950 text-amber-100 font-newspaper font-extrabold text-3xl rounded-xl border-2 border-emerald-800 shadow-md mb-2">
          A
        </div>
        <h1 class="font-newspaper font-black text-4xl tracking-tight text-emerald-950">The Daily Aafnokura</h1>
        <p class="text-xs font-serif italic text-emerald-900/70">"Join the community press & record your dispatches"</p>
      </div>

      <!-- Card -->
      <div class="bg-[#fafcf7] rounded-xl border border-emerald-900/20 shadow-[2px_3px_0px_rgba(6,78,59,0.1)] p-6 sm:p-8">
        <h2 class="font-newspaper font-extrabold text-xl text-emerald-950 mb-6 border-b border-emerald-900/10 pb-2">Create a Press Account</h2>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="mb-5 rounded-lg border border-rose-300 bg-rose-50/80 p-4 text-xs font-semibold text-rose-800 flex items-start gap-3">
            <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div><%= error %></div>
          </div>
        <% } %>

        <form action="/register" method="post" class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1.5">Full Name</label>
            <input 
              type="text" 
              name="name"
              value="<%= typeof formValues !== 'undefined' ? formValues.name || '' : '' %>"
              placeholder="e.g. Pushkar Chaudhary"
              class="w-full px-4 py-3 bg-[#f3f6f0] border border-emerald-900/20 rounded-lg outline-none focus:bg-white focus:border-emerald-800 focus:ring-2 focus:ring-emerald-900/10 transition-all text-sm font-medium"
              required 
            />
          </div>

          <div class="grid grid-cols-3 gap-3">
            <div class="col-span-2">
              <label class="block text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1.5">Username</label>
              <input 
                type="text" 
                name="username"
                value="<%= typeof formValues !== 'undefined' ? formValues.username || '' : '' %>"
                placeholder="pushkar"
                class="w-full px-4 py-3 bg-[#f3f6f0] border border-emerald-900/20 rounded-lg outline-none focus:bg-white focus:border-emerald-800 focus:ring-2 focus:ring-emerald-900/10 transition-all text-sm font-medium"
                required 
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1.5">Age</label>
              <input 
                type="number" 
                name="age" 
                min="13" 
                max="120"
                value="<%= typeof formValues !== 'undefined' ? formValues.age || '' : '' %>" 
                placeholder="18"
                class="w-full px-4 py-3 bg-[#f3f6f0] border border-emerald-900/20 rounded-lg outline-none focus:bg-white focus:border-emerald-800 focus:ring-2 focus:ring-emerald-900/10 transition-all text-sm font-medium" 
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1.5">Email Address</label>
            <input 
              type="email" 
              name="email"
              value="<%= typeof formValues !== 'undefined' ? formValues.email || '' : '' %>"
              placeholder="name@example.com"
              class="w-full px-4 py-3 bg-[#f3f6f0] border border-emerald-900/20 rounded-lg outline-none focus:bg-white focus:border-emerald-800 focus:ring-2 focus:ring-emerald-900/10 transition-all text-sm font-medium"
              required 
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-emerald-900 uppercase tracking-wider mb-1.5">Password</label>
            <input 
              type="password" 
              name="password" 
              placeholder="Minimum 8 characters"
              class="w-full px-4 py-3 bg-[#f3f6f0] border border-emerald-900/20 rounded-lg outline-none focus:bg-white focus:border-emerald-800 focus:ring-2 focus:ring-emerald-900/10 transition-all text-sm font-medium"
              required 
            />
          </div>

          <button 
            type="submit"
            class="w-full mt-3 py-3.5 px-4 bg-emerald-900 hover:bg-emerald-950 text-amber-100 font-bold rounded-lg shadow transition-all cursor-pointer text-sm"
          >
            Register Account &rarr;
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-emerald-900/10 text-center">
          <p class="text-xs font-medium text-emerald-900/80">
            Already registered with the Gazette?
            <a href="/login" class="text-emerald-900 font-bold hover:underline">Sign in here</a>
          </p>
        </div>
      </div>

    </div>
  </div>

  <footer class="py-6 text-center text-xs font-serif italic text-emerald-900/60">
    &copy; <%= new Date().getFullYear() %> The Daily Aafnokura Gazette &bull; All Rights Reserved.
  </footer>

</body>
</html>