<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Create Account</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col justify-between">

  <div class="flex-1 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <!-- Brand Header -->
      <div class="text-center mb-8">
        <div
          class="inline-flex items-center justify-center w-12 h-12 bg-indigo-600 text-white font-extrabold text-xl rounded-xl shadow-md mb-3">
        </div>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">Aafnokura</h1>
        <p class="text-sm text-gray-500 mt-1">Join the community and share your thoughts</p>
      </div>

      <!-- Card -->
      <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-6 sm:p-8">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Create an account</h2>

        <% if (typeof error !=='undefined' && error) { %>
          <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700 flex items-start gap-3">
            <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div>
              <%= error %>
            </div>
          </div>
          <% } %>

            <form action="/register" method="post" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Full Name</label>
                <input type="text" name="name"
                  value="<%= typeof formValues !== 'undefined' ? formValues.name || '' : '' %>"
                  placeholder="e.g. Pushkar Chaudhary"
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition text-sm"
                  required />
              </div>

              <div class="grid grid-cols-3 gap-3">
                <div class="col-span-2">
                  <label
                    class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Username</label>
                  <input type="text" name="username"
                    value="<%= typeof formValues !== 'undefined' ? formValues.username || '' : '' %>"
                    placeholder="e.g. pushkar"
                    class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition text-sm"
                    required />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Age</label>
                  <input type="number" name="age" min="13" max="120"
                    value="<%= typeof formValues !== 'undefined' ? formValues.age || '' : '' %>" placeholder="18"
                    class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition text-sm" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Email
                  Address</label>
                <input type="email" name="email"
                  value="<%= typeof formValues !== 'undefined' ? formValues.email || '' : '' %>"
                  placeholder="name@example.com"
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition text-sm"
                  required />
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Password</label>
                <input type="password" name="password" placeholder="Minimum 8 characters"
                  class="w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition text-sm"
                  required />
              </div>

              <button type="submit"
                class="w-full mt-2 py-3 px-4 bg-indigo-600 hover:bg-indigo-700 active:scale-[0.99] text-white font-semibold rounded-xl shadow-sm transition-all duration-150 cursor-pointer text-sm">
                Create Account
              </button>
            </form>

            <div class="mt-6 pt-5 border-t border-gray-100 text-center">
              <p class="text-sm text-gray-600">
                Already have an account?
                <a href="/login" class="text-indigo-600 hover:text-indigo-700 font-semibold transition">Sign in</a>
              </p>
            </div>
      </div>

    </div>
  </div>

  <footer class="py-4 text-center text-xs text-gray-400">
    &copy; <%= new Date().getFullYear() %> Aafnokura. Minimal & Friendly.
  </footer>

</body>

</html>