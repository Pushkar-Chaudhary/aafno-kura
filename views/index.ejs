<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Create Account</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <div class="min-h-screen flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
      <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Aafnokura</h1>
        <p class="mt-2 text-sm text-gray-500">Create your account</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="post" class="space-y-3">
        <input type="text" name="name" value="<%= typeof formValues !== 'undefined' ? formValues.name || '' : '' %>" placeholder="Name" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl outline-none focus:border-black transition" required />
        <input type="text" name="username" value="<%= typeof formValues !== 'undefined' ? formValues.username || '' : '' %>" placeholder="Username" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl outline-none focus:border-black transition" required />
        <input type="number" name="age" value="<%= typeof formValues !== 'undefined' ? formValues.age || '' : '' %>" min="13" placeholder="Age" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl outline-none focus:border-black transition" required />
        <input type="email" name="email" value="<%= typeof formValues !== 'undefined' ? formValues.email || '' : '' %>" placeholder="Email" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl outline-none focus:border-black transition" required />
        <input type="password" name="password" placeholder="Password" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl outline-none focus:border-black transition" required />

        <button type="submit" class="w-full px-3 py-2.5 bg-black text-white rounded-xl cursor-pointer hover:bg-gray-800 transition font-medium">
          Create Account
        </button>
      </form>

      <p class="mt-5 text-center text-sm text-gray-600">
        Already have an account?
        <a href="/login" class="text-black font-semibold">Login</a>
      </p>
    </div>
  </div>
</body>
</html>