<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    
    <div class="w-full h-screen bg-white-600"><h3 class="text-black w-full max-w-sm mx-auto space-y-3">Create Account</h3>
<form action="/register" method="post" class="w-full max-w-sm mx-auto space-y-3">

  <input
    type="text"
    name="name"
    placeholder="Name"
    class="w-full px-3 py-2.5 border border-gray-300 rounded-md outline-none focus:border-black transition"
  />

  <input
    type="text"
    name="username"
    placeholder="Username"
    class="w-full px-3 py-2.5 border border-gray-300 rounded-md outline-none focus:border-black transition"
  />

  <input
    type="number"
    name="age"
    placeholder="Age"
    class="w-full px-3 py-2.5 border border-gray-300 rounded-md outline-none focus:border-black transition"
  />

  <input
    type="email"
    name="email"
    placeholder="Email"
    class="w-full px-3 py-2.5 border border-gray-300 rounded-md outline-none focus:border-black transition"
  />

  <input
    type="password"
    name="password"
    placeholder="Password"
    class="w-full px-3 py-2.5 border border-gray-300 rounded-md outline-none focus:border-black transition"
  />

  <input
    type="submit"
    name="create-account"
    value="Create Account"
    class="w-full px-3 py-2.5 bg-black text-white rounded-md cursor-pointer hover:bg-gray-800 transition"
  />

</form>
    </div>
</body>
</html>