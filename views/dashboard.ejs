<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 text-gray-900">
  <%- include('partials/navbar', { user }) %>

  <main class="max-w-5xl mx-auto px-3 sm:px-4 py-6 sm:py-8">
    <div class="grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-8">
      <aside class="space-y-6">
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-500">Welcome back</p>
              <h2 class="text-2xl font-bold"><%= user.name %></h2>
            </div>
            <div class="bg-black text-white rounded-full w-12 h-12 flex items-center justify-center font-bold">
              <%= user.name.charAt(0).toUpperCase() %>
            </div>
          </div>

          <div class="mt-6 space-y-3 text-sm text-gray-600">
            <p><strong>@<%= user.username %></strong></p>
            <p><strong><%= user.posts ? user.posts.length : 0 %></strong> posts</p>
            <p><strong><%= posts.length %></strong> in your dashboard</p>
          </div>
        </div>
      </aside>

      <section class="space-y-6">
        <div class="bg-white rounded-2xl shadow-sm p-6">
          <h3 class="text-xl font-semibold mb-4">Create a post</h3>

          <form action="/post" method="post" class="space-y-3">
            <textarea
              name="content"
              rows="4"
              placeholder="What's happening?"
              class="w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black"
            ></textarea>
            <div class="flex justify-end">
              <button type="submit" class="bg-black text-white px-5 py-2.5 rounded-full font-medium hover:bg-gray-800">Post</button>
            </div>
          </form>
        </div>

        <div class="bg-white rounded-2xl shadow-sm p-6">
          <h3 class="text-xl font-semibold mb-5">Your posts</h3>

          <div class="space-y-4">
            <% if (posts.length === 0) { %>
              <p class="text-gray-500">No posts yet. Share your first update.</p>
            <% } %>

            <% posts.forEach(function(post) { %>
              <article class="border border-gray-200 rounded-2xl p-4">
                <div class="flex items-center justify-between mb-2">
                  <div>
                    <p class="font-semibold">@<%= post.user.username %></p>
                    <p class="text-xs text-gray-500"><%= new Date(post.date).toLocaleString() %></p>
                  </div>
                </div>

                <p class="text-gray-800 whitespace-pre-wrap"><%= post.content %></p>

                <div class="mt-4 flex items-center gap-4 text-sm">
                  <form action="/post/<%= post._id %>/like" method="post">
                    <button type="submit" class="text-blue-600">👍 <%= post.likes.length %></button>
                  </form>

                  <a href="/post/<%= post._id %>/edit" class="text-gray-600">Edit</a>

                  <form action="/post/<%= post._id %>/delete" method="post">
                    <button type="submit" class="text-red-600">Delete</button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    </div>
  </main>
</body>
</html>
