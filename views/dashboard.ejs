<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="bg-gradient-to-br from-zinc-50 via-zinc-100/50 to-indigo-50/20 text-zinc-900 antialiased min-h-screen selection:bg-indigo-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'dashboard' }) %>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="grid gap-8 lg:grid-cols-3">
      
      <!-- User Summary Sidebar -->
      <aside class="lg:col-span-1 space-y-6">
        <div class="bg-white/90 backdrop-blur-xl rounded-3xl border border-zinc-200/80 shadow-sm p-6 space-y-6 sticky top-24">
          <div class="flex items-center space-x-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-600 text-white flex items-center justify-center font-extrabold text-2xl shadow-md shadow-indigo-500/20">
              <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="space-y-0.5">
              <h2 class="text-lg font-bold text-zinc-900 leading-snug"><%= user.name %></h2>
              <p class="text-xs text-indigo-600 font-semibold">@<%= user.username %></p>
            </div>
          </div>

          <div class="pt-4 border-t border-zinc-100 space-y-2.5 text-xs font-medium text-zinc-600">
            <div class="flex items-center justify-between">
              <span class="text-zinc-400">Email</span>
              <span class="font-semibold text-zinc-800"><%= user.email %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-zinc-400">Total Publications</span>
              <span class="font-bold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-100"><%= posts.length %></span>
            </div>
          </div>

          <a href="/feed" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 bg-zinc-100 hover:bg-zinc-200/70 text-zinc-700 font-semibold text-xs rounded-xl transition-all">
            <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Browse Community Feed
          </a>
        </div>
      </aside>

      <!-- Main Content Area -->
      <section class="lg:col-span-2 space-y-6">
        
        <!-- Post Composer Card -->
        <div class="bg-white/90 backdrop-blur-xl rounded-3xl border border-zinc-200/80 shadow-sm p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-zinc-900 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
              Create a post
            </h3>
            <span id="charCounter" class="text-xs font-semibold text-zinc-400">0 / 2000</span>
          </div>

          <form action="/post" method="post" class="space-y-3">
            <textarea
              id="postInput"
              name="content"
              rows="3"
              maxlength="2000"
              placeholder="What's on your mind today?"
              class="w-full bg-zinc-50/80 border border-zinc-200/80 rounded-2xl p-4 text-sm text-zinc-900 outline-none focus:bg-white focus:border-indigo-600 focus:ring-4 focus:ring-indigo-600/10 transition-all resize-none placeholder:text-zinc-400"
              required
            ></textarea>
            
            <div class="flex items-center justify-between pt-1">
              <p class="text-xs text-zinc-400">Markdown supported for rich plain text.</p>
              <button 
                type="submit" 
                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-600/20 hover:shadow-indigo-600/30 transition-all cursor-pointer"
              >
                Post Update
              </button>
            </div>
          </form>
        </div>

        <!-- User Posts -->
        <div class="space-y-4">
          <div class="flex items-center justify-between px-1">
            <h3 class="text-base font-bold text-zinc-900 flex items-center gap-2">
              <span>Your Publications</span>
              <span class="text-xs text-indigo-600 font-bold bg-indigo-50 px-2 py-0.5 rounded-full"><%= posts.length %></span>
            </h3>
          </div>

          <% if (posts.length === 0) { %>
            <div class="bg-white/80 rounded-3xl border border-zinc-200/80 shadow-sm p-10 text-center space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <p class="text-zinc-600 font-semibold text-sm">No posts published yet</p>
              <p class="text-xs text-zinc-400">Share your thoughts using the creation box above!</p>
            </div>
          <% } %>

          <% posts.forEach(function(post) { %>
            <% const isLiked = post.likes ? post.likes.some(id => id.toString() === user._id.toString()) : false; %>
            <article class="bg-white/90 backdrop-blur-xl rounded-3xl border border-zinc-200/80 shadow-sm p-6 space-y-4 hover:border-zinc-300 transition-all">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-zinc-900">@<%= post.user ? post.user.username : user.username %></span>
                <span class="text-zinc-400 font-medium">
                  <%= new Date(post.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </span>
              </div>

              <p class="text-zinc-800 text-sm leading-relaxed whitespace-pre-wrap font-medium"><%= post.content %></p>

              <div class="pt-3 border-t border-zinc-100 flex items-center justify-between text-xs">
                <form action="/post/<%= post._id %>/like" method="post" class="inline">
                  <button type="submit" class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl border transition-all font-semibold active:scale-90 <%= isLiked ? 'bg-rose-50 text-rose-600 border-rose-200/80 shadow-2xs' : 'bg-zinc-50/80 text-zinc-600 border-zinc-200/80 hover:bg-zinc-100' %>">
                    <svg class="w-4 h-4 transition-transform <%= isLiked ? 'fill-rose-600 text-rose-600 scale-110' : 'text-zinc-400' %>" fill="<%= isLiked ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                    <span><%= post.likes ? post.likes.length : 0 %></span>
                  </button>
                </form>

                <div class="flex items-center space-x-2">
                  <a href="/post/<%= post._id %>/edit" class="px-3.5 py-1.5 rounded-xl border border-zinc-200/80 bg-zinc-50/80 text-zinc-700 hover:bg-zinc-100 transition-all font-semibold">
                    Edit
                  </a>
                  <form action="/post/<%= post._id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');" class="inline">
                    <button type="submit" class="px-3.5 py-1.5 rounded-xl border border-rose-200/80 bg-rose-50/80 text-rose-600 hover:bg-rose-100 transition-all font-semibold">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

      </section>
    </div>
  </main>

  <script>
    const textarea = document.getElementById('postInput');
    const counter = document.getElementById('charCounter');
    if (textarea && counter) {
      textarea.addEventListener('input', () => {
        const len = textarea.value.length;
        counter.textContent = `${len} / 2000`;
        if (len > 1800) {
          counter.classList.add('text-amber-600');
        } else {
          counter.classList.remove('text-amber-600');
        }
      });
    }
  </script>
</body>
</html>
