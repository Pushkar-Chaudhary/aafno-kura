<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      font-family: 'Manrope', sans-serif;
      background:
        radial-gradient(circle at top left, rgba(139, 92, 246, 0.10), transparent 22%),
        linear-gradient(135deg, #f9f6f2 0%, #f3f7ff 45%, #f8fafc 100%);
      color: #0f172a;
    }
    .font-brand { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen selection:bg-violet-500 selection:text-white">
  <%- include('partials/navbar', { user, activePage: 'dashboard' }) %>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-8 rounded-2xl border border-slate-200 bg-white/90 px-6 py-5 shadow-[0_16px_40px_rgba(15,23,42,0.05)] backdrop-blur-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.26em] text-violet-600">Your workspace</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">Dashboard</h1>
      <p class="mt-1 text-sm text-slate-500">Create updates, manage your posts, and keep your profile tidy.</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      <aside class="lg:col-span-1 space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sticky top-28">
          <div class="flex items-center space-x-4 border-b border-slate-200 pb-5">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-violet-600 text-white shadow-sm">
              <% const isAdminDashboard = user && (user.role === 'admin' || user.email === 'pushkarchaudhary256@gmail.com'); %>
              <% if (isAdminDashboard) { %>
                <span class="text-2xl font-extrabold">A</span>
              <% } else { %>
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 21a8 8 0 0 0-16 0"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              <% } %>
            </div>
            <div class="space-y-0.5">
              <h2 class="text-xl font-bold text-slate-900"><%= user.name %></h2>
              <p class="text-xs font-semibold text-violet-600">@<%= user.username %></p>
              <% if (user.role === 'admin' || user.email === 'pushkarchaudhary256@gmail.com') { %>
                <span class="mt-1 inline-block rounded-full bg-amber-100 px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-slate-900">Admin</span>
              <% } else { %>
                <span class="mt-1 inline-block rounded-full bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-slate-700">Member</span>
              <% } %>
            </div>
          </div>

          <div class="mt-5 space-y-3 text-xs font-medium text-slate-600">
            <div class="flex items-center justify-between border-b border-slate-200 pb-2">
              <span class="uppercase tracking-wide text-slate-500">Email</span>
              <span class="font-semibold text-slate-900"><%= user.email %></span>
            </div>
            <div class="flex items-center justify-between border-b border-slate-200 pb-2">
              <span class="uppercase tracking-wide text-slate-500">Posts</span>
              <span class="rounded-full bg-violet-50 px-2.5 py-1 text-sm font-extrabold text-violet-700"><%= posts.length %></span>
            </div>
          </div>

          <a href="/feed" class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-violet-600 to-violet-500 px-4 py-2.5 text-xs font-bold text-white shadow-[0_12px_28px_rgba(109,40,217,0.22)] transition hover:from-violet-500 hover:to-violet-600">
            Open feed →
          </a>
        </div>
      </aside>

      <section class="lg:col-span-2 space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <h3 class="text-lg font-bold text-slate-900">Create a post</h3>
            <span id="charCounter" class="text-xs font-bold text-slate-500">0 / 2000</span>
          </div>

          <form action="/post" method="post" class="mt-4 space-y-3">
            <textarea
              id="postInput"
              name="content"
              rows="4"
              maxlength="2000"
              placeholder="Write your update..."
              class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-800 outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100 placeholder:text-slate-400 shadow-inner"
              required
            ></textarea>

            <div class="flex items-center justify-between pt-1">
              <p class="text-[11px] text-slate-500">Share something useful with the community.</p>
              <button type="submit" class="rounded-xl bg-gradient-to-r from-violet-600 to-violet-500 px-5 py-2.5 text-xs font-bold text-white shadow-[0_12px_28px_rgba(109,40,217,0.22)] transition hover:from-violet-500 hover:to-violet-600">
                Publish post →
              </button>
            </div>
          </form>
        </div>

        <div class="space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2">
            <h3 class="text-xl font-extrabold text-slate-900">Your posts</h3>
            <span class="rounded-full bg-violet-50 px-2.5 py-1 text-xs font-bold text-violet-700"><%= posts.length %> published</span>
          </div>

          <% if (posts.length === 0) { %>
            <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center">
              <p class="text-lg font-bold text-slate-900">No posts yet</p>
              <p class="mt-2 text-sm text-slate-500">Your first post will appear here.</p>
            </div>
          <% } %>

          <% posts.forEach(function(post) { %>
            <% const isLiked = post.likes ? post.likes.some(id => id.toString() === user._id.toString()) : false; %>
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex items-center justify-between border-b border-slate-200 pb-3 text-xs text-slate-500">
                <span class="font-semibold text-slate-700">@<%= post.user ? post.user.username : user.username %></span>
                <span><%= new Date(post.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
              </div>

              <div class="mt-4 whitespace-pre-wrap text-sm leading-7 text-slate-700">
                <%= post.content %>
              </div>

              <div class="mt-5 flex items-center justify-between border-t border-slate-200 pt-3 text-xs font-bold">
                <form action="/post/<%= post._id %>/like" method="post" class="inline">
                  <button type="submit" class="rounded-lg border px-3.5 py-1.5 transition active:scale-95 <%= isLiked ? 'border-rose-200 bg-rose-50 text-rose-700' : 'border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100' %>">
                    ♥ <%= post.likes ? post.likes.length : 0 %>
                  </button>
                </form>

                <div class="flex items-center space-x-2">
                  <a href="/post/<%= post._id %>/edit" class="rounded-lg border border-slate-200 bg-slate-50 px-3.5 py-1.5 text-slate-700 hover:bg-slate-100">
                    Edit
                  </a>
                  <form action="/post/<%= post._id %>/delete" method="post" onsubmit="return confirm('Delete this post?');" class="inline">
                    <button type="submit" class="rounded-lg border border-rose-200 bg-rose-50 px-3.5 py-1.5 text-rose-700 hover:bg-rose-100">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    </div>
  </main>

  <script>
    const textarea = document.getElementById('postInput');
    const counter = document.getElementById('charCounter');
    if (textarea && counter) {
      textarea.addEventListener('input', () => {
        const len = textarea.value.length;
        counter.textContent = `${len} / 2000`;
      });
    }
  </script>
</body>
</html>
</html>
