<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aafnokura | Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen">
  <%- include('partials/navbar', { user }) %>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <div class="grid gap-8 lg:grid-cols-3">
      
      <!-- User Summary Sidebar -->
      <aside class="lg:col-span-1 space-y-6">
        <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-6">
          <div class="flex items-center space-x-4">
            <div class="w-14 h-14 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-bold text-2xl shadow-sm">
              <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900 leading-tight"><%= user.name %></h2>
              <p class="text-sm text-indigo-600 font-medium">@<%= user.username %></p>
            </div>
          </div>

          <div class="mt-6 pt-6 border-t border-gray-100 space-y-3 text-sm text-gray-600">
            <div class="flex items-center justify-between">
              <span class="text-gray-500">Email</span>
              <span class="font-medium text-gray-800"><%= user.email %></span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-gray-500">Total Posts</span>
              <span class="font-semibold px-2.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 text-xs"><%= posts.length %></span>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Section -->
      <section class="lg:col-span-2 space-y-6">
        
        <!-- Post Composer -->
        <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            Create a post
          </h3>

          <form action="/post" method="post" class="space-y-3">
            <textarea
              name="content"
              rows="3"
              placeholder="What's on your mind today?"
              class="w-full bg-gray-50 border border-gray-200 rounded-xl p-3.5 text-sm text-gray-900 outline-none focus:bg-white focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 transition resize-none"
              required
            ></textarea>
            <div class="flex justify-end">
              <button 
                type="submit" 
                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white text-sm font-semibold rounded-xl shadow-sm transition"
              >
                Post Update
              </button>
            </div>
          </form>
        </div>

        <!-- User Posts Feed -->
        <div class="space-y-4">
          <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2 px-1">
            <span>Your Posts</span>
            <span class="text-xs text-gray-500 font-normal">(<%= posts.length %>)</span>
          </h3>

          <% if (posts.length === 0) { %>
            <div class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-8 text-center">
              <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              <p class="text-gray-500 text-sm">You haven't created any posts yet.</p>
              <p class="text-xs text-gray-400 mt-1">Share your first update using the box above!</p>
            </div>
          <% } %>

          <% posts.forEach(function(post) { %>
            <% const isLiked = post.likes.some(id => id.toString() === user._id.toString()); %>
            <article class="bg-white rounded-2xl border border-gray-200/80 shadow-sm p-5 space-y-3 hover:border-gray-300 transition">
              <div class="flex items-center justify-between text-xs text-gray-500">
                <span class="font-semibold text-gray-700">@<%= post.user ? post.user.username : user.username %></span>
                <span><%= new Date(post.date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
              </div>

              <p class="text-gray-800 text-sm leading-relaxed whitespace-pre-wrap"><%= post.content %></p>

              <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs">
                <form action="/post/<%= post._id %>/like" method="post" class="inline">
                  <button type="submit" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border transition font-medium <%= isLiked ? 'bg-red-50 text-red-600 border-red-200' : 'bg-gray-50 text-gray-600 border-gray-200 hover:bg-gray-100' %>">
                    <svg class="w-4 h-4 <%= isLiked ? 'fill-red-600 text-red-600' : 'text-gray-500' %>" fill="<%= isLiked ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                    <span><%= post.likes ? post.likes.length : 0 %></span>
                  </button>
                </form>

                <div class="flex items-center space-x-2">
                  <a href="/post/<%= post._id %>/edit" class="px-3 py-1.5 rounded-lg border border-gray-200 bg-gray-50 text-gray-700 hover:bg-gray-100 transition font-medium">
                    Edit
                  </a>
                  <form action="/post/<%= post._id %>/delete" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');" class="inline">
                    <button type="submit" class="px-3 py-1.5 rounded-lg border border-red-200 bg-red-50 text-red-600 hover:bg-red-100 transition font-medium">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

      </section>
    </div>
  </main>

</body>
</html>
